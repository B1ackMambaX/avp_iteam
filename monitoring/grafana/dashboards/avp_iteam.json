{
  "uid": "avp-iteam-overview",
  "title": "avp_iteam: конвейер маппинга и NLP",
  "tags": ["avp_iteam"],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Операций обработано за период",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(avpiteam_mapping_processed_total[$__range]))" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "В очереди (NEW + IN_PROGRESS)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(avpiteam_nlp_queue_size{status=~\"NEW|IN_PROGRESS\"})" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "FAILED в очереди",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(avpiteam_nlp_queue_size{status=\"FAILED\"})" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Ошибки вызова NLP за период",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(avpiteam_nlp_detect_errors_total[$__range])) or vector(0)" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Throughput, операций/с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(avpiteam_mapping_processed_total[$__rate_interval]))", "legendFormat": "маппинг" },
        { "refId": "B", "expr": "sum(rate(avpiteam_nlp_detect_seconds_count[$__rate_interval]))", "legendFormat": "NLP detect" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Очередь nlp_task по статусам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (avpiteam_nlp_queue_size)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Латентность NLP detect (Java, с вызовом Python)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(avpiteam_nlp_detect_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(avpiteam_nlp_detect_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(avpiteam_nlp_detect_seconds_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Время обработки пачки маппинга",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(avpiteam_mapping_batch_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(avpiteam_mapping_batch_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Статусы маппинга, операций/с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 40, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(avpiteam_mapping_results_total[$__rate_interval]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Решения классификатора (Python), запросов/с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 40, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (decision) (rate(nlp_classify_total[$__rate_interval]))", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Где уходит время: p95 по слоям",
      "description": "Java detect − Python HTTP = сеть, WebClient и ожидание в пуле. Python HTTP − эмбеддинги = gate, Natasha и сериализация.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(avpiteam_nlp_detect_seconds_bucket[$__rate_interval])))", "legendFormat": "Java detect (целиком)" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"avp_iteam_nlp\"}[$__rate_interval])))", "legendFormat": "Python HTTP (все эндпоинты)" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(nlp_embedding_seconds_bucket[$__rate_interval])))", "legendFormat": "Эмбеддинги" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Извлечение имён: доля найденных",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(nlp_extract_name_total{found=\"true\"}[$__rate_interval])) / sum(rate(nlp_extract_name_total[$__rate_interval]))", "legendFormat": "имя найдено" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "CPU",
      "description": "Системная загрузка включает и Python, так как оба сервиса на одном хосте.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{job=\"avp_iteam_backend\"}", "legendFormat": "Java-процесс" },
        { "refId": "B", "expr": "system_cpu_usage{job=\"avp_iteam_backend\"}", "legendFormat": "вся система" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "JVM heap по пулам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (id) (jvm_memory_used_bytes{job=\"avp_iteam_backend\", area=\"heap\"})", "legendFormat": "{{id}}" }
      ]
    },
    {
      "id": 15, "type": "timeseries", "title": "Пул соединений БД (Hikari)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active)", "legendFormat": "активные" },
        { "refId": "B", "expr": "sum(hikaricp_connections_pending)", "legendFormat": "ждут соединения" },
        { "refId": "C", "expr": "sum(hikaricp_connections_max)", "legendFormat": "максимум" }
      ]
    },
    {
      "id": 16, "type": "timeseries", "title": "Результаты detect по способу классификации, оп/с",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 40, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (method, genuine_third_party) (rate(avpiteam_nlp_detect_results_total[$__rate_interval]))", "legendFormat": "{{method}}, настоящее третье лицо: {{genuine_third_party}}" }
      ]
    }
  ]
}